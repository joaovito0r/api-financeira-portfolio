# Configuração de produção — copie para .env.prod e preencha
# Usado por: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# O domínio agora é configurado no Caddy compartilhado, ver /home/joao/portifolio/infra/

# Senha do Postgres — gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Token da brapi.dev (https://brapi.dev)
BRAPI_TOKEN=
