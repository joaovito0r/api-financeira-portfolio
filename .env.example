# API Financeira - Configuração
# Copie este arquivo para .env e preencha os valores

# Token da brapi.dev (https://brapi.dev)
# Modo gratuito: apenas PETR4 e VALE3 funcionam sem token
BRAPI_TOKEN=seu_token_aqui

# Banco de Dados
# SQLite (dev): sqlite+aiosqlite:///./data/financeira.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@host:5432/financeira
DATABASE_URL=sqlite+aiosqlite:///./data/financeira.db

# Ambiente
ENVIRONMENT=development
DEBUG=true

# Servidor
HOST=0.0.0.0
PORT=8000
